# Every setting of Wheelman. `wheelman setup` writes .env for you; or copy this file to .env.
# Amounts are USDC, written like 1.50. An empty value means "not set". Never commit .env.

# --- RPC: any provider ---
# Required. Your HTTPS JSON-RPC endpoint: Helius, Triton, QuickNode, or your own node. No default.
RPC_URL=
# The websocket endpoint for account updates. Default: RPC_URL with wss://.
RPC_WS_URL=
# A Yellowstone gRPC endpoint (Triton, Helius LaserStream); it replaces the websocket. Run `npm install @triton-one/yellowstone-grpc` first.
GRPC_URL=
# The token for GRPC_URL.
GRPC_TOKEN=
# A send-only endpoint for transactions. Default: RPC_URL.
SEND_URL=
# A tip in lamports added to each transaction, for a SEND_URL that requires one. 0 is no tip.
SEND_TIP_LAMPORTS=0
# The address the tip goes to, as your send provider names it.
SEND_TIP_ACCOUNT=
# A standby endpoint. It takes over only while RPC_URL fails, never at the same time.
RPC_FALLBACK_URL=
# The most requests a second Wheelman sends to each endpoint (1 to 500).
RPC_MAX_RPS=10
# The largest priority fee Wheelman pays, in micro-lamports per compute unit.
MAX_PRIORITY_FEE=100000

# --- Keys: the owner's wallet, or a session key for an agent ---
# The owner's keypair file. `wheelman setup` writes wallets/bot-keypair.json with mode 600.
KEYPAIR_PATH=wallets/bot-keypair.json
# The owner's secret key itself (a JSON array of 64 numbers, or base58), for a host without secret files.
WALLET_SECRET_KEY=
# `wheelman setup --yes` only: a keypair file to copy into wallets/bot-keypair.json.
WALLET_IMPORT=
# The wallet's address, for a process that holds no key: an agent with a session key, or a dry run.
OWNER=
# A session key that trades for OWNER within its allowance and expiry (`wheelman session start` writes it).
SESSION_KEYPAIR_PATH=

# --- What to trade ---
# knockout-momentum, knockout-fade, knockout-straddle, minute-trend, minute-schedule or template.
STRATEGY=knockout-momentum
# BTC, ETH, SOL or XRP. XAU works with PRICE_SOURCE=replay only.
MARKET=BTC
# Strategy parameters are PARAM_<NAME>. The names, defaults and bounds of each strategy are in README.md.
PARAM_STAKE_USDC=1
# More strategy modules to load, comma-separated paths. Each exports `strategies`.
EXTRA_STRATEGIES=

# --- Risk limits, checked before every trade (the bot's and every `open`) ---
# The largest stake of one position or round.
MAX_STAKE_USDC=1
# The most positions and live rounds open at once (1 to 12).
MAX_OPEN=2
# Required to trade, above 0. Nothing opens while today's loss (UTC), plus every open stake, would pass this.
DAILY_LOSS_USDC=
# Nothing opens that could leave the wallet below this, even if every open stake is lost.
MIN_BALANCE_USDC=0

# --- Prices for the strategy's signal and for paper fills ---
# coinbase (a public feed, no key; BTC, ETH, SOL, XRP) or replay (a recorded tape, paper mode only).
PRICE_SOURCE=coinbase
# The tape for PRICE_SOURCE=replay: one JSON line a price, {"time": ms or ISO, "market": "BTC", "price": 1.23}.
REPLAY_FILE=

# --- Local state ---
# The folder for the log (journal.jsonl), the paper account (paper.json) and a cache of settled transactions.
STATE_DIR=.wheelman
# The USDC a paper account starts with.
PAPER_USDC=100
